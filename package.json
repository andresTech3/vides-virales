  "description": "Generador de Videos Virales 9:16 por Código con Inteligencia Artificial y Remotion",
  "private": true,
  "type": "module",
  "scripts": {
    "estudio": "remotion studio src/remotion/index.ts",
    "render:bridge": "remotion render src/remotion/index.ts BridgeShort salida/bridge.mp4 --codec h264 --crf 16",
