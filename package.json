    "audio:mix": ".venv\\Scripts\\python.exe audio/mix.py",
    "qa": ".venv\\Scripts\\python.exe scripts/short_qa.py",
    "generar": "tsx src/cli/index.ts",
    "limpiar": "node scripts/limpiar.mjs",
    "limpiar:todo": "tsx src/cli/index.ts --limpiar-todo"
  },
