    "@remotion/three": "4.0.539",
    "@remotion/transitions": "4.0.539",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "postprocessing": "^6.39.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.539",
    "three": "^0.170.0",
    "zod": "^3.23.8"
